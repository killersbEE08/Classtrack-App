<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource-shrinker keep list.

  Release builds enable `isShrinkResources = true` (see android/app/build.gradle.kts).
  These notification drawables are referenced ONLY by string name at runtime
  (flutter_local_notifications / firebase_messaging resolve them via
  Resources.getIdentifier(name, "drawable", pkg)), so the shrinker cannot see
  the reference and strips them from the release APK/AAB. At runtime the lookup
  then returns id 0 and FlutterLocalNotificationsPlugin.getIconFromSource throws
  `IllegalArgumentException: Drawable resource ID must not be 0` — the crash seen
  on the Present/Absent action buttons.

  Keeping them here makes the notification small-icon and action icons survive
  minification/shrinking.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_notify,@drawable/ic_action_present,@drawable/ic_action_absent" />
