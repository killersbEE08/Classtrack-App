rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // A user's own files: timetable imports (users/{uid}/imports/**) and note
    // attachments (users/{uid}/noteAttachments/**).
    match /users/{uid}/{allPaths=**} {
      // The owner can always read their own files.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Uploads are limited to the owner, capped at 10 MB, and (when a
      // contentType is reported) restricted to images/PDFs. contentType can be
      // null on some clients — the earlier rule called .matches() on it
      // unconditionally, which THROWS and denies every upload with an
      // "unauthorized" error, so we now guard for null first. The 10 MB cap is
      // kept in sync with NoteAttachmentService.maxBytes on the client.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (request.resource == null
            || (request.resource.size < 10 * 1024 * 1024
                && (request.resource.contentType == null
                    || request.resource.contentType.matches('image/.*')
                    || request.resource.contentType == 'application/pdf')));
    }

    // CMS media library (marketing images, logos, banners). Publicly readable
    // (served by URL in the app); writable only by content/marketing roles,
    // images only, capped at 5 MB.
    match /cms/media/{allPaths=**} {
      function role() {
        return request.auth != null && request.auth.token.role is string
          ? request.auth.token.role : 'none';
      }
      allow read: if true;
      // Uploads: content/marketing roles only, <5 MB, and restricted to SAFE
      // RASTER image types. SVG (image/svg+xml) is deliberately EXCLUDED — it
      // can embed <script>, which would be stored-XSS since these assets are
      // served from a public URL. A null contentType is also rejected on
      // upload (raster pickers always set one); `request.resource == null` is
      // kept so deletes still work for the role.
      allow write: if request.auth != null
        && role() in ['super_admin', 'admin', 'editor', 'marketing']
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType in [
                    'image/png', 'image/jpeg', 'image/jpg',
                    'image/webp', 'image/gif'
                  ]));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
